{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "skipLibCheck": true, "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "noEmit": true, "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src", "vite.config.ts"]
}
