DATABASE_URL=postgresql://petcorner:CHANGE_ME@127.0.0.1:5432/petcorner?schema=public
# Tests require a separate database whose name ends in _test.
TEST_DATABASE_URL=postgresql://petcorner:CHANGE_ME@127.0.0.1:5432/petcorner_test?schema=public
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ORDER_TOKEN_SECRET=replace-with-another-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
APP_PUBLIC_URL=http://localhost:5174
ADMIN_PUBLIC_URL=http://localhost:5175
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=/uploads
# Set an exact hop count (1–5) only after verifying the reverse proxy topology.
# Production requires Supabase storage and actual HTTPS origins; see .env.production.example.
TRUST_PROXY=false

# Optional local direct/session migration URL; local fallback is DATABASE_URL.
DIRECT_URL=
# Only used when STORAGE_PROVIDER=supabase (see production example).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
