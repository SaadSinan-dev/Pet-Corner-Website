# Backend hosting runtime secrets/settings only. Never copy to a Pages project.
NODE_ENV=production
HOST=0.0.0.0
PORT=10000
DATABASE_URL=
JWT_SECRET=
ORDER_TOKEN_SECRET=
# Exact actual HTTPS origins, comma-separated. No trailing slash or wildcard.
CORS_ORIGINS=
APP_PUBLIC_URL=
ADMIN_PUBLIC_URL=
# A declared path alone does not provision a persistent disk: attach it on the host.
STORAGE_PROVIDER=local
UPLOAD_DIR=/app/uploads
# Independent Pages requires actual https://API_HOST/uploads (not the frontend).
PUBLIC_UPLOAD_BASE_URL=
# Set 1-5 only after confirming the host's reverse-proxy hop count.
TRUST_PROXY=false
# No TEST_DATABASE_URL in production. WhatsApp and delivery policy are saved in admin settings.
