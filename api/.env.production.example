# Backend runtime only. Copy actual values into Render, not Cloudflare/GitHub.
NODE_ENV=production
HOST=0.0.0.0
PORT=10000
# Supabase Connect > Session pooler, IPv4-compatible port 5432.
# Both can use the same session URL initially; add sslmode=require&sslaccept=strict.
# For transaction runtime port 6543 also set pgbouncer=true&connection_limit=3.
DATABASE_URL=
# Migrations always use session 5432 (or reachable IPv6 direct), never transaction 6543.
DIRECT_URL=
JWT_SECRET=
ORDER_TOKEN_SECRET=
CORS_ORIGINS=
APP_PUBLIC_URL=
ADMIN_PUBLIC_URL=
STORAGE_PROVIDER=supabase
SUPABASE_URL=
# Server secret sb_secret_... or legacy service_role JWT. Never anon/publishable.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
# Confirm the proxy hop count first; 1-5 supported. false is a safe default.
TRUST_PROXY=false
# No local upload directory/public upload base or test database in production.
# WhatsApp number and delivery policy are persisted through admin settings.
