# Copy to an ignored .env file for Docker Compose. Use unique random secrets.
JWT_SECRET=
ORDER_TOKEN_SECRET=
CORS_ORIGINS=
VITE_SITE_URL=
APP_PUBLIC_URL=
ADMIN_PUBLIC_URL=
# Optional HTTPS edge: DNS names only, no scheme/path.
STORE_DOMAIN=
ADMIN_DOMAIN=
TLS_EMAIL=
TRUST_PROXY=false

# Supabase runtime values for the optional self-hosted Compose API.
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
