# Copy to an ignored .env file for Docker Compose. Use unique random hex strings.
# POSTGRES_PASSWORD MUST be URL-safe hexadecimal: do not use / ? # @ : or spaces.
POSTGRES_PASSWORD=
JWT_SECRET=
ORDER_TOKEN_SECRET=
CORS_ORIGINS=
VITE_SITE_URL=
APP_PUBLIC_URL=
ADMIN_PUBLIC_URL=
# Optional HTTPS edge: DNS names only, no scheme/path.
STORE_DOMAIN=
ADMIN_DOMAIN=
TLS_EMAIL=
TRUST_PROXY=false
